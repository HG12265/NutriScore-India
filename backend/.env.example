# NutriScore AI - Backend Environment Variables
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Algorithm Configuration: icmr_16_nutrient | full_39_nutrient | official_nutri_score
DEFAULT_ALGORITHM_MODE=icmr_16_nutrient

# Database Configuration (Optional MongoDB)
# Set ENABLE_HISTORY=true only if you have a running MongoDB instance
ENABLE_HISTORY=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nutriscore
